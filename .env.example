# Copy to .env for local development. Every setting is optional; the defaults
# are chosen so that `python run.py` works with no configuration at all.

# SQLite locally, Postgres in production.
# BEACON_DATABASE_URL=postgresql+psycopg://beacon:beacon@localhost:5432/beacon

# Signs the session cookie. Anyone holding this value can forge a login for any
# account, so generate a fresh one before deploying:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# BEACON_SESSION_SECRET=

# Restrict the session cookie to HTTPS. Leave off for http://localhost.
# BEACON_SESSION_HTTPS_ONLY=true

# Only enable behind a proxy that overwrites X-Forwarded-For. Any client can set
# that header themselves.
# BEACON_TRUST_PROXY_HEADERS=true

# Path to a MaxMind GeoLite2-Country.mmdb. Without it, country reads "Unknown".
# BEACON_GEOIP_DB_PATH=/data/GeoLite2-Country.mmdb

# Seconds between in-process rollup refreshes. 0 disables the loop.
# BEACON_ROLLUP_INTERVAL_SECONDS=60
